@{
    ViewData["Title"] = "Access Denied";
}

<div class="text-center py-5">
    <div style="font-size:64px; color:var(--danger); margin-bottom:16px;">
        <i class="bi bi-shield-exclamation"></i>
    </div>
    <h2 class="mb-3">Access Denied</h2>
    <p class="text-muted mb-4">You do not have permission to access this resource.<br />Please contact your system administrator if you believe this is an error.</p>
    <a href="@Url.Action("Index", "Dashboard")" class="btn btn-primary">
        <i class="bi bi-arrow-left"></i> Return to Dashboard
    </a>
</div>
