@model StudentDetailsViewModel
@{
    ViewData["Title"] = "Delete Student";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Delete Student</h1>
        <p class="page-subtitle">Confirm deletion of this student record.</p>
    </div>
    <a href="@Url.Action("Index", "Students")" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Back to Students
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card delete-card">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <div style="font-size:56px; color:var(--danger);">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                    </div>
                    <h4 class="mt-3 mb-2">Are you sure you want to delete this student?</h4>
                    <p class="text-muted">This action cannot be undone. The student record will be permanently removed from the database.</p>
                </div>

                <div class="bg-light rounded p-3 mb-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="detail-item">
                                <div class="detail-label">Student Name</div>
                                <div class="detail-value fw-bold">@Model.FullName</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="detail-item">
                                <div class="detail-label">Admission Number</div>
                                <div class="detail-value"><code>@Model.AdmissionNumber</code></div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="detail-item">
                                <div class="detail-label">Email</div>
                                <div class="detail-value">@Model.Email</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="detail-item">
                                <div class="detail-label">Course</div>
                                <div class="detail-value">@Model.Course</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-3 justify-content-center">
                    <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger px-4" data-confirm-delete>
                            <i class="bi bi-trash"></i> Yes, Delete Student
                        </button>
                    </form>
                    <a href="@Url.Action("Details", "Students", new { id = Model.Id })" class="btn btn-outline-secondary px-4">
                        Cancel
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
