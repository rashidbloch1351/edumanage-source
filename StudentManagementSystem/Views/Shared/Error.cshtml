@model StudentManagementSystem.Models.ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="text-center py-5">
    <div style="font-size:64px; color:var(--danger); margin-bottom:16px;">
        <i class="bi bi-exclamation-octagon-fill"></i>
    </div>
    <h2 class="mb-3">Something Went Wrong</h2>
    <p class="text-muted mb-4">An error occurred while processing your request. Please try again later.</p>
    @if (Model.ShowRequestId)
    {
        <p class="text-muted" style="font-size:12px;">
            <strong>Request ID:</strong> <code>@Model.RequestId</code>
        </p>
    }
    <a href="@Url.Action("Index", "Dashboard")" class="btn btn-primary">
        <i class="bi bi-house"></i> Return to Dashboard
    </a>
</div>
